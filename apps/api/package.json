{
  "name": "@oston/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./handler": "./src/http-adapter.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "admin:create": "tsx src/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@oston/contracts": "workspace:*",
    "@oston/database": "workspace:*",
    "@vercel/blob": "2.8.0",
    "better-auth": "1.7.2",
    "dotenv": "17.2.3",
    "fastify": "5.12.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@oston/config": "workspace:*",
    "@types/node": "24.6.0",
    "eslint": "9.37.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "3.2.6"
  }
}
