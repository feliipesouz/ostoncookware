# --- Database (Neon) ---
# Runtime: connection pooled (`-pooler`)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma CLI / migrations: conexão direta
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Local Docker (`docker compose up -d`) escuta em localhost:5433.
# Não use 5432 — costuma ser outro projeto. Prefira `.env.local` (não versionado)
# para apontar a API/Prisma ao Postgres OSTON, sem sobrescrever o `.env`.

# --- Auth ---
BETTER_AUTH_SECRET="replace-with-32-plus-character-secret"
# URL pública do site (same-origin via rewrite Next → API)
BETTER_AUTH_URL="http://localhost:3000"

# --- Origins ---
NODE_ENV="development"
WEB_ORIGIN="http://localhost:3000"
API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Media (Vercel Blob) ---
# Somente na API. Nunca NEXT_PUBLIC.
BLOB_READ_WRITE_TOKEN=""

# --- Cache invalidation (API → web) ---
REVALIDATION_SECRET="replace-with-random-secret"

# --- Optional observability ---
SENTRY_DSN=""

# --- First admin (`pnpm admin:create`) ---
ADMIN_EMAIL="rodrigo@ostoncookware.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Rodrigo"

# Preview/staging: use um projeto Neon separado. Não aponte Preview da Vercel para o banco de production.
# ALLOW_DEMO_SEED="true"
